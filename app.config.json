{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "http": { "enabled": true },
    "stdio": { "enabled": true }
  },
  "storage": {
    "root": "~/.openclaw/xcache-mcp"
  },
  "x_api": {
    "base": "https://api.x.com"
  },
  "logging": {
    "level": "info",
    "events": true,
    "bodies": true
  },
  "tools": {
    "enabled": ["x_posts_since", "x_follows_changes_since"]
  },
  "throttle": {
    "default_min_interval": "24h",
    "operations": {
      "get_user_following": "24h",
      "get_latest_posts": "1h",
      "get_user_by_username": "7d",
      "get_user_by_id": "7d",
      "get_tweet": "never",
      "verify_posts": "7d",
      "raw_get": "24h"
    },
    "error_retry_intervals": {
      "401": "never",
      "403": "never",
      "404": "1h",
      "429": "1h",
      "5xx": "5m",
      "network": "1m"
    }
  }
}
