{
  "name": "xcache-mcp",
  "version": "0.1.0",
  "description": "Personal-scale read-only proxy for the X (Twitter) API v2 with aggressive caching and MCP integration.",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "main": "dist/src/index.js",
  "bin": {
    "xcache-mcp": "dist/src/index.js",
    "xcache-mcp-consolidate": "dist/bin/consolidate.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "consolidate": "tsx bin/consolidate.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
