# Required: app-only bearer token for api.x.com (Twitter API v2). This is the
# ONLY secret the proxy reads from the environment. All other configuration
# lives in app.config.json (see XCACHE_CONFIG below).
X_BEARER_TOKEN=

# Optional: path to the JSON config file. Defaults to ./app.config.json.
# Everything else (host, port, transports, log levels, x_api base, enabled
# tools, throttle intervals, retry policy) is configured there.
# XCACHE_CONFIG=/etc/xcache-mcp/app.config.json
