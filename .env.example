# Required: app-only bearer token for api.x.com (Twitter API v2)
X_BEARER_TOKEN=

# Optional: HTTP listener config
XCACHE_PORT=8787
XCACHE_HOST=127.0.0.1

# Optional: data directory (db + logs). Defaults to ~/.openclaw/xcache-mcp
# XCACHE_ROOT=/Users/yourname/.openclaw/xcache-mcp

# Optional: throttle config path
# XCACHE_THROTTLE_CONFIG=./throttle.config.json

# Optional: disable HTTP listener (set to 1)
# XCACHE_NO_HTTP=

# Optional: disable MCP stdio transport (set to 1)
# XCACHE_NO_STDIO=

# Optional: skip writing bodies log (set to 0)
# XCACHE_LOG_BODIES=1

# Optional: Fastify/pino log level
LOG_LEVEL=info

# Optional: override X API base URL (testing only)
# X_API_BASE=https://api.x.com
